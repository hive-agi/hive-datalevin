{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.5"}

        ;; datalevin — LMDB-backed Datalog store (published, no fork).
        datalevin/datalevin {:mvn/version "0.10.18"}

        ;; hive-spi — IKGStore / IConnInit protocol contracts (pure leaf).
        io.github.hive-agi/hive-spi {:mvn/version "0.1.20"}

        ;; hive-dsl — Result/rescue DSL.
        io.github.hive-agi/hive-dsl {:mvn/version "0.5.14"}

        com.taoensso/timbre {:mvn/version "6.8.0"}}

 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps  {io.github.cognitect-labs/test-runner
                       {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                       ;; stateful Machine check for the conn-lifecycle contract
                       io.github.hive-agi/hive-test {:mvn/version "0.3.12"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}

  ;; Clojars publishing. version = the repo's VERSION file.
  :build
  {:deps {io.github.hive-agi/hive-build {:mvn/version "0.1.8"}}
   :ns-default hive-build.api}}}
